<Window x:Class="BetterVoice.App.Overlay.RecordingHUDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterVoice HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight">
    <Border Background="#E618181B"
            CornerRadius="24"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="18,10"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Pulsing Status Dot -->
            <Ellipse x:Name="StatusDot"
                     Width="12" Height="12"
                     Fill="#EF4444"
                     VerticalAlignment="Center"
                     Margin="0,0,12,0" />

            <!-- Text Information -->
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="StatusText"
                           Text="Listening..."
                           Foreground="#F4F4F5"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="MicText"
                           Text="Default Microphone"
                           Foreground="#A1A1AA"
                           FontSize="11" />
            </StackPanel>

            <!-- Live Audio Level Bars -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle x:Name="Bar1" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.5,0" />
                <Rectangle x:Name="Bar2" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.5,0" />
                <Rectangle x:Name="Bar3" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.5,0" />
                <Rectangle x:Name="Bar4" Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.5,0" />
                <Rectangle x:Name="Bar5" Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#38BDF8" Margin="1.5,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
